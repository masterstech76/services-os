# ==============================================================================
# ServicePro OS — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to admin_web/.env.local for local Vite development, or set
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in your hosting provider.

# ------------------------------------------------------------------------------
# 1. ADMIN & STAFF WEB PORTAL (admin_web — Vite Client Variables)
# ------------------------------------------------------------------------------
# Read directly by admin_web/src/services/supabaseClient.ts via import.meta.env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. CUSTOMER & TECHNICIAN FLUTTER MOBILE APP (serviceos — --dart-define)
# ------------------------------------------------------------------------------
# Passed at compile/run time to serviceos/lib/core/network/supabase_service.dart:
# flutter run --dart-define=SUPABASE_URL=https://your-project-ref.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 3. OPTIONAL FUTURE SERVER-SIDE / EDGE FUNCTION INTEGRATIONS (NOT YET WIRED)
# ------------------------------------------------------------------------------
# The following keys are reserved for server-side Supabase Edge Functions when
# connecting live Stripe Connect payment capture, Twilio SMS, or SMTP email.
# Never expose secret keys (sk_live_*, service_role, auth tokens) in client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
INITIAL_ADMIN_BOOTSTRAP_SECRET=your-one-time-server-bootstrap-secret-min-16-chars
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
