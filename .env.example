# ==============================================================================
# ServicePro OS — Environment Variables Template
# ==============================================================================

# Core Application Settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_MODE=real
ALLOW_DEMO_AUTH=false

# ------------------------------------------------------------------------------
# 1. DATABASE OPTIONS (Configure 1, 2, or all 3 simultaneously)
# ------------------------------------------------------------------------------
# Option 1: Supabase Cloud (Identity, WebSockets & Media Bucket)
ENABLE_DB_SUPABASE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=job-photos

# Option 2: Dedicated / Local PostgreSQL (Primary Transactional Ledger)
ENABLE_DB_POSTGRES=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/servicepro
POSTGRES_POOL_SIZE=10
POSTGRES_SSL=require

# Option 3: AWS Database RDS / Aurora (Immutable Audit Trail & Telemetry)
ENABLE_DB_AWS=false
AWS_RDS_ENDPOINT=aurora-cluster.region.rds.amazonaws.com
AWS_RDS_DATABASE=servicepro_telemetry
AWS_RDS_USER=dbadmin
AWS_RDS_PASSWORD=your_secure_rds_password
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY (STRIPE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_demo
STRIPE_SECRET_KEY=sk_test_placeholder_secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# ------------------------------------------------------------------------------
# 3. SMS & PHONE OTP CARRIER (Select 1: twilio | aws_sns | console)
# ------------------------------------------------------------------------------
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=AC_placeholder_sid
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_FROM_NUMBER=+13055550100
AWS_SNS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_placeholder
AWS_SECRET_ACCESS_KEY=placeholder_secret_key

# ------------------------------------------------------------------------------
# 4. EMAIL DELIVERY ENGINE (Select 1: aws_ses | smtp | resend)
# ------------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_FROM="CoolAir Dispatch" <dispatch@your-domain.com>
AWS_SES_REGION=us-east-1
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
SMTP_SECURE=tls
RESEND_API_KEY=re_placeholder_key

# ------------------------------------------------------------------------------
# 5. MAPS & GEOCODING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.placeholder
MAPBOX_SERVER_TOKEN=sk.placeholder
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy_placeholder

# ------------------------------------------------------------------------------
# 6. SYSTEM SECURITY & CRON
# ------------------------------------------------------------------------------
CRON_SECRET=generate_a_secure_random_hex_string
INITIAL_OWNER_EMAIL=owner@your-domain.com
INITIAL_OWNER_PASSWORD=ChangeMeInProduction123!
