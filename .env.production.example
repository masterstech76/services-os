# ==============================================================================
# ServicePro OS — Production Environment Configuration (.env.production.example)
# ==============================================================================
# Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in your static hosting
# environment (Vercel, Netlify, Cloudflare Pages, AWS Amplify) before building.

# ------------------------------------------------------------------------------
# 1. ADMIN & STAFF WEB PRODUCTION CLIENT VARIABLES (Vite Build-Time)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-production-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-public-key

# ------------------------------------------------------------------------------
# 2. FLUTTER MOBILE PRODUCTION BUILD VARIABLES (--dart-define)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-production-ref.supabase.co
SUPABASE_ANON_KEY=your-production-anon-public-key

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE EDGE FUNCTION SECRETS (Supabase Vault / Secrets Manager Only)
# ------------------------------------------------------------------------------
# WARNING: Never prefix these with VITE_ or bundle them into client apps.
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
INITIAL_ADMIN_BOOTSTRAP_SECRET=your-one-time-server-bootstrap-secret-min-16-chars
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_signing_secret
TWILIO_ACCOUNT_SID=AC_your_production_account_sid
TWILIO_AUTH_TOKEN=your_production_auth_token
TWILIO_FROM_NUMBER=+10000000000
